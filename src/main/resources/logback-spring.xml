<?xml version="1.0" encoding="UTF-8"?>
<!--
  Same structure as Spring Boot's own default logback config (defaults.xml +
  console-appender.xml + root), but with %msg/%m redirected through
  ScrubbingMessageConverter so every formatted log line - not just the ones a
  developer remembers to scrub by hand - gets checked for password/token/card
  patterns before it's written anywhere. See that class for what it redacts.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <conversionRule
        conversionWord="msg"
        converterClass="com.mockingbirdbank.config.logging.ScrubbingMessageConverter" />
    <conversionRule
        conversionWord="m"
        converterClass="com.mockingbirdbank.config.logging.ScrubbingMessageConverter" />

    <include resource="org/springframework/boot/logging/logback/console-appender.xml" />

    <!--
      A separate, durable sink for AnalyticsEventService's product/error events, independent of
      the regular application log above - so "what are people actually doing/hitting" is a
      dedicated, greppable/shippable stream rather than mixed in with framework noise. Rolls
      daily, kept 30 days. Uses the same %msg scrubbing as CONSOLE even though attributes here
      shouldn't contain secrets - defense in depth costs nothing.
    -->
    <appender name="ANALYTICS_EVENTS" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>build/logs/analytics-events.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>build/logs/analytics-events.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.mockingbirdbank.analytics.events" level="INFO" additivity="true">
        <appender-ref ref="ANALYTICS_EVENTS" />
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
