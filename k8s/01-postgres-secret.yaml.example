# Template for the Postgres credentials Secret. Copy this file to
# 01-postgres-secret.yaml (gitignored - see .gitignore) and fill in a
# real, generated password before applying to any shared cluster. For a
# production/compliance-bound deployment, prefer sourcing this from a
# proper secrets manager (e.g. External Secrets Operator, or Harness's
# built-in secret manager) instead of a hand-edited YAML file.
apiVersion: v1
kind: Secret
metadata:
  name: mockingbird-postgres
  namespace: mockingbird-bank
type: Opaque
stringData:
  POSTGRES_DB: mockingbird
  POSTGRES_USER: mockingbird
  POSTGRES_PASSWORD: REPLACE_ME_WITH_A_GENERATED_SECRET
