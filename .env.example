# Copy to .env and adjust for your local Postgres before running
# runDockerImage.zsh. The real .env is gitignored - never commit it.
#
# On Docker Desktop (macOS/Windows), host.docker.internal reaches a Postgres
# instance running on the host machine from inside the app container.

SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/mydatabase
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=secret

# Uncomment to have the app listen on something other than the container
# default (8080). Pair with a matching -p host:container change if you do.
# SERVER_PORT=8080
